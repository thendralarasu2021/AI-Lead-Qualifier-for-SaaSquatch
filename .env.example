# Copy this file to .env.local and fill in your own values.
# NEVER put real keys in this file - it is committed to GitHub.

# Supabase (optional - enables the 24h cache)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
